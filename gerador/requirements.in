# As dependências diretas do gerador, com a versão fixa. O requirements.txt (o que se instala) sai deste arquivo, com
# as dependências transitivas e os hashes; depois de mudar aqui, regenere-o com o comando do topo dele.
osmium==4.3.1      # leitura do extrato do OpenStreetMap (pyosmium), com as áreas das relações
shapely==2.1.2     # município e bairro de cada registro, pela malha do IBGE e pelos polígonos de bairro
zstandard==0.25.0  # compactação dos bancos (.sqlite.zst)
pyarrow==23.0.1    # lugares da Overture (GeoParquet no S3), HS4
